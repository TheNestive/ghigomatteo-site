# ------------------------------------------------------------------
# Variables d'environnement — À DÉFINIR sur le serveur (Hostinger).
# Copier ce fichier en .env.local (jamais commité) pour le développement.
# ------------------------------------------------------------------

# Mot de passe de la page d'administration (/admin)
ADMIN_PASSWORD=change-moi

# --- Envoi des emails du formulaire de contact (SMTP) ---
# Ex. avec une boîte mail Hostinger :
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@ton-domaine.com
SMTP_PASS=mot-de-passe-de-la-boite-mail

# Optionnel — destinataires (par défaut les deux adresses du site) :
# CONTACT_TO=matteo.ghigo@nestiveprod.com,thenestivepro@gmail.com

# Optionnel — adresse d'expédition (par défaut = SMTP_USER) :
# CONTACT_FROM=contact@ton-domaine.com
